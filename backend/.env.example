# Copy to backend/.env and fill in the values:  cp .env.example .env
# backend/.env is git-ignored — never commit real secrets.

# ── Required ─────────────────────────────────────────────────────────────────
# Secret key used to sign JWT access tokens (at least 32 characters).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Access token lifetime in hours (1-24)
JWT_EXPIRATION_HOURS=8

# SQLite database file (default: backend/viperv2.db)
# DATABASE_URL=sqlite:///./viperv2.db

# NVD API key — optional, raises the NVD rate limit from 5 to 50 requests / 30 s.
# Request one (free) at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# How long NVD answers are cached in memory (seconds)
CVE_CACHE_TTL=3600

# Attack path generation limits
MAX_ATTACK_PATHS=30
MAX_ATTACK_HOPS=6
