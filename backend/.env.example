APP_NAME=ViperV2 Network Scanner
VERSION=2.0.0
DEBUG=false

# Database (SQLite)
DATABASE_URL=sqlite:///./viperv2.db

# Security & Authentication
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Scanning Configuration
SCAN_TIMEOUT=300
ARP_TIMEOUT=3.0
PORT_SCAN_RANGE=1-1024
NMAP_ARGUMENTS=-sV -O --host-timeout 60s -T4

# Vulnerability scanning (NVD API)
# Get free key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
CVE_CACHE_TTL=3600
VULN_SCAN_ENABLED=true

# Attack Graph
MAX_ATTACK_PATHS=30
MAX_ATTACK_HOPS=6

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
